generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  googleId     String       @unique
  email        String       @unique
  name         String
  picture      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  teachers     Teacher[]
  rooms        Room[]
  subjects     Subject[]
  classGroups  ClassGroup[]
  timeSlots    TimeSlot[]
  timetables   Timetable[]
}

model Teacher {
  id              String            @id @default(uuid())
  name            String
  email           String
  subjects        TeacherSubject[]
  availability    TeacherTimeSlot[]
  scheduleEntries ScheduleEntry[]
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String

  @@unique([userId, email])
}

model Room {
  id              String          @id @default(uuid())
  name            String
  capacity        Int
  hasLabEquipment Boolean         @default(false)
  scheduleEntries ScheduleEntry[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
}

model Subject {
  id                String           @id @default(uuid())
  name              String
  code              String
  hoursPerWeek      Int
  requiresLab       Boolean          @default(false)
  maxSessionsPerDay Int              @default(1)
  teachers          TeacherSubject[]
  scheduleEntries   ScheduleEntry[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String

  @@unique([userId, code])
}

model ClassGroup {
  id              String          @id @default(uuid())
  name            String
  studentCount    Int
  scheduleEntries ScheduleEntry[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
}

model TimeSlot {
  id              String            @id @default(uuid())
  day             String            
  startTime       String            
  endTime         String            
  teacherSlots    TeacherTimeSlot[]
  scheduleEntries ScheduleEntry[]
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
}

model Timetable {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  entries   ScheduleEntry[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model ScheduleEntry {
  id           String     @id @default(uuid())
  timetable    Timetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  timetableId  String
  teacher      Teacher    @relation(fields: [teacherId], references: [id])
  teacherId    String
  room         Room       @relation(fields: [roomId], references: [id])
  roomId       String
  subject      Subject    @relation(fields: [subjectId], references: [id])
  subjectId    String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String
  timeSlot     TimeSlot   @relation(fields: [timeSlotId], references: [id])
  timeSlotId   String

  @@unique([timetableId, teacherId, timeSlotId])   
  @@unique([timetableId, roomId, timeSlotId])       
  @@unique([timetableId, classGroupId, timeSlotId])
}

model TeacherSubject {
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String
  @@id([teacherId, subjectId])
}

model TeacherTimeSlot {
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
  teacherId  String
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])
  timeSlotId String
  @@id([teacherId, timeSlotId])
}