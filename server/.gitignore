# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Prisma
# Keep schema and migrations, exclude generated client
!prisma/schema.prisma
!prisma/migrations/

# Don't commit JS/declaration files in src (except Prisma generated)
src/**/*.js
src/**/*.d.ts
src/**/*.js.map
src/**/*.d.ts.map
!src/generated/**
